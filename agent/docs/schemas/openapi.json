            "title": "Utilization Ratio",
            "type": "number"
          },
          "cache_hit_ratio": {
            "default": 0.0,
            "title": "Cache Hit Ratio",
            "type": "number"
          },
          "uncached_input_tokens": {
            "default": 0,
