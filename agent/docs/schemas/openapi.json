  "components": {
    "schemas": {
      "ActiveToolView": {
        "additionalProperties": false,
        "description": "当前正在执行的工具状态。",
        "properties": {
          "tool_call_id": {
            "title": "Tool Call Id",
            "type": "string"
          },
          "tool_name": {
            "title": "Tool Name",
            "type": "string"
          },
          "args_preview": {
            "default": "",
            "title": "Args Preview",
            "type": "string"
          },
          "started_at": {
            "title": "Started At",
            "type": "string"
          }
        },
        "required": [
          "tool_call_id",
          "tool_name",
          "started_at"
        ],
        "title": "ActiveToolView",
        "type": "object"
      },
      "ApprovalContextView": {
        "additionalProperties": false,
        "description": "审批请求所属会话与任务上下文。",
        "properties": {
          "main_conversation_id": {
            "title": "Main Conversation Id",
            "type": "string"
          },
          "task_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Task Id"
          },
          "role_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Role Name"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "user_intent": {
            "default": "",
            "title": "User Intent",
            "type": "string"
          }
        },
        "required": [
          "main_conversation_id",
          "run_id"
        ],
        "title": "ApprovalContextView",
        "type": "object"
      },
      "ApprovalItemView": {
        "additionalProperties": false,
        "description": "待逐条勾选审核的单个工具调用描述。",
        "properties": {
          "item_id": {
            "title": "Item Id",
            "type": "string"
          },
          "tool_name": {
            "title": "Tool Name",
            "type": "string"
          },
          "args": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Args",
            "type": "object"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "rule_id": {
            "title": "Rule Id",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "risk_level": {
            "default": "medium",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Risk Level",
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "tool_name",
          "category",
          "rule_id",
          "reason"
        ],
        "title": "ApprovalItemView",
        "type": "object"
      },
      "ApprovalPayloadView": {
        "additionalProperties": false,
        "description": "权限审核交互详情。",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ApprovalItemView"
            },
            "title": "Items",
            "type": "array"
          },
          "context": {
            "$ref": "#/components/schemas/ApprovalContextView"
          }
        },
        "required": [
          "items",
          "context"
        ],
        "title": "ApprovalPayloadView",
        "type": "object"
      },
      "AskUserOptionView": {
        "additionalProperties": false,
        "description": "AskUser 单个可选项。",
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Description"
          }
        },
        "required": [
          "label"
        ],
        "title": "AskUserOptionView",
        "type": "object"
      },
      "AskUserPayloadView": {
        "additionalProperties": false,
        "description": "LLM 选择建议问答交互详情。",
        "properties": {
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/AskUserQuestionView"
            },
            "title": "Questions",
            "type": "array"
          }
        },
        "required": [
          "request_id",
          "questions"
        ],
        "title": "AskUserPayloadView",
        "type": "object"
      },
      "AskUserQuestionView": {
        "additionalProperties": false,
        "description": "AskUser 单个问题。",
        "properties": {
          "header": {
            "title": "Header",
            "type": "string"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/AskUserOptionView"
            },
            "title": "Options",
            "type": "array"
          },
          "multi_select": {
            "default": false,
            "title": "Multi Select",
            "type": "boolean"
          }
        },
        "required": [
          "header",
          "question",
          "options"
        ],
        "title": "AskUserQuestionView",
        "type": "object"
      },
      "AuxJevUsageView": {
        "additionalProperties": false,
        "description": "Jev 辅助决策模型用量（独立列项，不混入主模型窗口与账单）。",
        "properties": {
          "source": {
            "enum": [
              "semantic_router",
              "permission_review",
              "mcp_compile",
              "other"
            ],
            "title": "Source",
            "type": "string"
          },
          "requests": {
            "default": 0,
            "title": "Requests",
            "type": "integer"
          },
          "input_tokens": {
            "default": 0,
            "title": "Input Tokens",
            "type": "integer"
          },
          "output_tokens": {
            "default": 0,
            "title": "Output Tokens",
            "type": "integer"
          },
          "total_tokens": {
            "default": 0,
            "title": "Total Tokens",
            "type": "integer"
          },
          "cost_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cost Usd"
          }
        },
        "required": [
          "source"
        ],
        "title": "AuxJevUsageView",
        "type": "object"
      },
      "BranchView": {
        "additionalProperties": false,
        "description": "Level 1 宏观分支树节点视图。",
        "properties": {
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "scope": {
            "title": "Scope",
            "type": "string"
          },
          "parent_conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Parent Conversation Id"
          },
          "role_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Role Name"
          },
          "task_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Task Id"
          },
          "target_title": {
            "default": "",
            "title": "Target Title",
            "type": "string"
          },
          "work_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Work Path"
          },
          "branch_mode": {
            "default": "root_only",
            "enum": [
              "root",
              "root_only",
              "handoff",
              "full_fork"
            ],
            "title": "Branch Mode",
            "type": "string"
          },
          "forked_from": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Forked From"
          },
          "forked_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Forked At"
          },
          "head_entry_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Head Entry Id"
          },
          "status": {
            "default": "idle",
            "title": "Status",
            "type": "string"
          },
          "is_running": {
            "default": false,
            "title": "Is Running",
            "type": "boolean"
          },
          "message_count": {
            "default": 0,
            "title": "Message Count",
            "type": "integer"
          },
          "active_task_count": {
            "default": 0,
            "title": "Active Task Count",
            "type": "integer"
          },
          "pending_interaction_count": {
            "default": 0,
            "title": "Pending Interaction Count",
            "type": "integer"
          },
          "usage_summary": {
            "$ref": "#/components/schemas/RunUsageView"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "conversation_id",
          "scope",
          "updated_at"
        ],
        "title": "BranchView",
        "type": "object"
      },
      "BudgetProgressView": {
        "additionalProperties": false,
        "description": "对照 LoopBudgetPolicy 的预算消耗水位。",
        "properties": {
          "requests_ratio": {
            "default": 0.0,
            "title": "Requests Ratio",
            "type": "number"
          },
          "tool_calls_ratio": {
            "default": 0.0,
            "title": "Tool Calls Ratio",
            "type": "number"
          },
          "tokens_ratio": {
            "default": 0.0,
            "title": "Tokens Ratio",
            "type": "number"
          },
          "soft_limit_reached": {
            "default": false,
            "title": "Soft Limit Reached",
            "type": "boolean"
          }
        },
        "title": "BudgetProgressView",
        "type": "object"
      },
      "ContextBucketView": {
        "additionalProperties": false,
        "description": "Context Window 9 大分类桶之一。",
        "properties": {
          "category": {
            "enum": [
              "system_prompt",
              "environment_info",
              "skills",
              "mcp",
              "builtin_tools",
              "memory",
              "attachments",
              "messages",
              "overhead"
            ],
            "title": "Category",
            "type": "string"
          },
          "tokens": {
            "title": "Tokens",
            "type": "integer"
          },
          "ratio": {
            "title": "Ratio",
            "type": "number"
          },
          "sub_items": {
            "items": {
              "$ref": "#/components/schemas/ContextSubItemView"
            },
            "title": "Sub Items",
            "type": "array"
          }
        },
        "required": [
          "category",
          "tokens",
          "ratio"
