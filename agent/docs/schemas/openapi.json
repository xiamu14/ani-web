        "properties": {
          "deferred_mcp_tools_count": {
            "default": 0,
            "title": "Deferred Mcp Tools Count",
            "type": "integer"
          },
          "deferred_mcp_tokens_saved_est": {
            "default": 0,
            "title": "Deferred Mcp Tokens Saved Est",
            "type": "integer"
          },
          "deferred_skills_count": {
            "default": 0,
            "title": "Deferred Skills Count",
            "type": "integer"
          },
          "deferred_skills_tokens_saved_est": {
            "default": 0,
            "title": "Deferred Skills Tokens Saved Est",
            "type": "integer"
          },
          "opt6_omitted_media_count": {
            "default": 0,
            "title": "Opt6 Omitted Media Count",
            "type": "integer"
          }
        },
        "title": "ContextSavingsView",
        "type": "object"
      },
      "ContextSubItemView": {
        "additionalProperties": false,
        "description": "单个分类桶内部的细分子项消耗。",
        "properties": {
          "name": {
            "title": "Name",
