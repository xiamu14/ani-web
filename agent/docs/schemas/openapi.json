          },
          "window_limit_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Window Limit Tokens"
          },
          "limit_known": {
            "default": false,
            "title": "Limit Known",
            "type": "boolean"
          },
          "utilization_ratio": {
