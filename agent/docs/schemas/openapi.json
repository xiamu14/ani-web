          },
          "tokens": {
            "title": "Tokens",
            "type": "integer"
          },
          "detail": {
            "default": "",
            "title": "Detail",
            "type": "string"
          },
          "scaled": {
            "default": false,
            "title": "Scaled",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "tokens"
